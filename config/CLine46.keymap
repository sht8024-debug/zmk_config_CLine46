#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// conductor-keymap (6).json (2026-07-31 実機からRead→Export・Diff=No changes確認済み) 完全同期版
// Conductor Studio実測値: Tapping Term 200ms / ホールド判定=タップ優先 / quick-tap 200ms
// レイヤー番号はConductorと完全一致: 0=base 1=symbol 2=number 3=move 4=mouse
// 5=scroll 6=setting 7-11=(空) 12=Precision 13=Gesture
// CLine46固有: 外側列(Tab/[/LCtrl/]/F5音声入力/mo5), scroll層R30のstudio_unlock,
// zoomコンボはCmd+スクロールで近似(Conductorのピンチズームは専用機能のため)

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // K+L → スクロールレイヤー(5)ホールド
        combo_scroll {
            bindings = <&mo 5>;
            key-positions = <20 21>;
            timeout-ms = <50>;
        };

        // I+O → ジェスチャーレイヤー(13)ホールド
        combo_gesture {
            bindings = <&mo 13>;
            key-positions = <8 9>;
            timeout-ms = <50>;
        };

        // Q+A+Z → BTプロファイル3(ペアリング用予備枠)
        combo_pair {
            bindings = <&bt BT_SEL 3>;
            key-positions = <1 13 25>;
            timeout-ms = <50>;
        };

        // T+O+B → ブートローダー(UF2書込モード)
        combo_boot {
            bindings = <&bootloader>;
            key-positions = <5 9 29>;
            timeout-ms = <50>;
        };

        // K+L+minus → ズーム(Conductorのピンチズーム相当: Cmd+スクロール)
        combo_zoom {
            bindings = <&zoom_hold>;
            key-positions = <20 21 22>;
            timeout-ms = <50>;
        };
    };

    behaviors {
        // Cmd押しっぱなし+スクロールレイヤー(多くのMacアプリでズームになる)
        zoom_hold: zoom_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &mo 5>
                , <&macro_pause_for_release>
                , <&macro_release &kp LGUI &mo 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "base";
            bindings = <
&kp TAB          &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P            &kp LEFT_BRACKET
&kp LCTRL         &kp A             &kp S             &kp D             &kp F             &kp G             &kp H             &kp J             &kp K             &kp L             &kp MINUS         &kp RIGHT_BRACKET
&kp F5          &mt LSHIFT Z    &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &mt RSHIFT FSLH &mo 5
&kp TAB        &kp LCTRL      &kp LALT       &mt LGUI LANG2 &lt 1 SPACE    &lt 2 BSPC     &lt 3 ENTER    &mt RGUI LANG1 &kp C_VOL_DN   &kp C_VOL_UP
            >;
        };

        layer_1 {
            display-name = "symbol";
            bindings = <
&trans    &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &trans
&trans         &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5)) &none          &none          &kp MINUS      &kp EQUAL      &kp LBKT       &kp RBKT       &kp BSLH       &trans
&trans    &none     &none     &none     &none     &none     &none     &none     &kp SEMI  &kp SQT   &kp GRAVE &trans
&kp ESC &none   &none   &none   &none   &mo 6   &none   &none   &none   &none
            >;
        };

        layer_2 {
            display-name = "number";
            bindings = <
&trans    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp N1    &kp N2    &kp N3    &kp PLUS  &kp MINUS &trans
&trans   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp N4   &kp N5   &kp N6   &kp STAR &kp FSLH &trans
&trans  &kp F11 &kp F12 &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &none   &none   &trans
&none   &none   &none   &none   &none   &none   &kp DOT &kp N0  &none   &none
            >;
        };

        layer_3 {
            display-name = "move";
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans        &kp LC(UP)    &kp LC(LEFT)  &kp UP        &kp LC(RIGHT) &kp LC(DOWN)  &trans
&trans    &trans    &trans    &trans    &trans    &trans    &kp LC(A) &kp LEFT  &kp DOWN  &kp RIGHT &kp LC(E) &trans
&trans        &trans        &trans        &trans        &trans        &trans        &kp C_PREV    &kp LG(LEFT)  &none         &kp LG(RIGHT) &kp C_NEXT    &trans
&none        &none        &none        &none        &none        &none        &none        &none        &kp C_BRI_DN &kp C_BRI_UP
            >;
        };

        layer_4 {
            display-name = "mouse";
            bindings = <
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans   &none    &none    &none    &none    &none    &none    &none    &mkp MB1 &mkp MB2 &mkp MB3 &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&none &none &none &none &none &none &none &none &none &none
            >;
        };

        layer_5 {
            display-name = "scroll";
            bindings = <
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&none          &none          &none          &none          &none          &none          &studio_unlock &none          &none          &none
            >;
        };

        layer_6 {
            display-name = "setting";
            bindings = <
&trans       &none        &none        &none        &none        &none        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans
&trans &none  &none  &none  &none  &none  &none  &trans &trans &tg 12 &none  &trans
&trans &none  &trans &trans &trans &none  &none  &none  &none  &none  &none  &trans
&none          &none          &none          &none          &none          &none          &none          &bootloader    &bt BT_CLR     &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            display-name = "l7";
            bindings = <
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&none &none &none &none &none &none &none &none &none &none
            >;
        };

        layer_8 {
            display-name = "l8";
            bindings = <
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&none &none &none &none &none &none &none &none &none &none
            >;
        };

        layer_9 {
            display-name = "l9";
            bindings = <
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&none &none &none &none &none &none &none &none &none &none
            >;
        };

        layer_10 {
            display-name = "l10";
            bindings = <
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&none &none &none &none &none &none &none &none &none &none
            >;
        };

        layer_11 {
            display-name = "l11";
            bindings = <
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&none &none &none &none &none &none &none &none &none &none
            >;
        };

        layer_12 {
            display-name = "Precision";
            bindings = <
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&trans   &none    &none    &none    &none    &none    &none    &none    &mkp MB1 &mkp MB2 &mkp MB3 &trans
&trans &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans
&none  &none  &none  &none  &none  &none  &none  &none  &none  &tg 12
            >;
        };

        layer_13 {
            display-name = "Gesture";
            bindings = <
&trans       &none        &none        &none        &none        &none        &none        &none        &kp LC(DOWN) &none        &none        &trans
&trans        &none         &none         &none         &none         &none         &none         &kp LC(RIGHT) &none         &kp LC(LEFT)  &none         &trans
&trans     &none      &none      &none      &none      &none      &none      &none      &kp LC(UP) &none      &none      &trans
&none &none &none &none &none &none &none &none &none &none
            >;
        };

    };
};
